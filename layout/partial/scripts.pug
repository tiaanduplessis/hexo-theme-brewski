script(src='https://cdnjs.cloudflare.com/ajax/libs/barba.js/1.0.0/barba.min.js')
script.
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof Barba === 'undefined') return

        var paginationUrl = null
        function cancelPaginationScroll() {
            paginationUrl = null
        }

        // A newer click or history/anchor navigation cancels the previous intent.
        document.addEventListener('click', cancelPaginationScroll, true)
        window.addEventListener('popstate', cancelPaginationScroll, true)
        window.addEventListener('hashchange', cancelPaginationScroll)

        Barba.Dispatcher.on('linkClicked', function(link) {
            var parent = link.parentNode
            if (!Barba.Pjax.transitionProgress && parent &&
                parent.classList.contains('paginator')) {
                paginationUrl = link.href
            }
        })

        Barba.Dispatcher.on('transitionCompleted', function(current) {
            if (paginationUrl && current.url === paginationUrl &&
                window.location.href === paginationUrl) {
                window.scrollTo(0, 0)
            }
            cancelPaginationScroll()
        })

        Barba.Pjax.start()
    })
